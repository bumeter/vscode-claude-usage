{
  "name": "bumeter-claude-usage",
  "displayName": "Claude Code Usage — Quota & Context in the Status Bar",
  "description": "See your Claude Code usage limits in the VS Code status bar: 5-hour and weekly quota left, reset times, a forecast and this workspace's context. 13 status bar styles. Local only, nothing leaves your machine. By Bumeter (unofficial, not made by Anthropic).",
  "version": "0.4.0",
  "publisher": "bumkom",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/bumeter/vscode-claude-usage"
  },
  "homepage": "https://bumeter.cc",
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude code",
    "claude code usage",
    "claude usage",
    "usage limit",
    "rate limit",
    "quota",
    "5-hour limit",
    "weekly limit",
    "claude max",
    "claude pro",
    "statusline",
    "status bar",
    "context",
    "context window",
    "tokens",
    "claude",
    "anthropic",
    "ai",
    "bumeter"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeUsage.open",
        "title": "Open Usage",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeUsage.setupTracking",
        "title": "Set Up Quota Tracking",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeUsage.removeTracking",
        "title": "Remove Quota Tracking",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeUsage.refresh",
        "title": "Refresh",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeUsage.chooseStyle",
        "title": "Choose Status Bar Style",
        "category": "Claude Code Usage"
      },
      {
        "command": "claudeUsage.getFull",
        "title": "Get Bumeter (Overview, Skills, Files)",
        "category": "Claude Code Usage"
      }
    ],
    "configuration": {
      "title": "Claude Code Usage",
      "properties": {
        "claudeUsage.style": {
          "type": "string",
          "default": "classic",
          "enum": [
            "classic",
            "countdown",
            "forecast",
            "smooth",
            "split",
            "compact",
            "bars",
            "traffic",
            "resetclock",
            "battery",
            "peak",
            "context",
            "minimal",
            "custom"
          ],
          "enumDescriptions": [
            "5h 62% · 7d 41% · ctx 312K",
            "5h 62% ↻1h20 · 7d 41% ↻3d4h",
            "5h 62% → 100% at 16:40",
            "5h ███▊░░ 62% · 7d ██▌░░░",
            "Three items: 5h, 7d, ctx, each with its own colour",
            "62% · 41%",
            "5h ▰▰▰▰▰▰▱▱▱▱  7d ▰▰▰▰▱▱▱▱▱▱",
            "🟢 5h 62%  🟢 7d 41%",
            "5h 62% · resets 14:20",
            "🔋 38% · 59% left",
            "Only the window closest to its limit: 5h 62%",
            "ctx 312K ▰▰▰▰▰▰▱▱ · 5h 62%",
            "62 (the rest is in the tooltip)",
            "Your own template: claudeUsage.customFormat"
          ],
          "markdownDescription": "How the status bar draws the quota. Run **Claude Code Usage: Choose Status Bar Style** to preview them as you move through the list."
        },
        "claudeUsage.customFormat": {
          "type": "string",
          "default": "",
          "markdownDescription": "The template of the `custom` style. Values: `{5h}` `{7d}` `{5hLeft}` `{7dLeft}` `{5hReset}` `{7dReset}` `{5hResetAt}` `{7dResetAt}` `{5hHits}` `{ctx}` `{ctxPct}` `{bar5h}` `{bar7d}` `{barCtx}` `{smooth5h}` `{smooth7d}` `{light5h}` `{light7d}` `{peak}` `{blocked}`; icons as `$(flame)`. Example: `$(flame) {5h} | {7d} | ctx {ctxPct}`."
        },
        "claudeUsage.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the `bum` command. Empty: the one bundled with the extension, then `bum` on PATH."
        },
        "claudeUsage.alerts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Notify before the quota runs out: when the 5-hour or weekly quota crosses `claudeUsage.alertAt`, when at this pace it runs out before it resets, and when this session's context is over its threshold. Each once. Off while full Bumeter is installed."
        },
        "claudeUsage.alertAt": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "default": [
            80,
            90
          ],
          "markdownDescription": "Quota percentages that notify (from 90% the notification is a warning)."
        }
      }
    }
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2a1f4d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundle-bum": "node scripts/bundle-bum.mjs"
  },
  "devDependencies": {
    "@bumeter/vscode-kit": "^0.3.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "bugs": {
    "url": "https://github.com/bumeter/vscode-claude-usage/issues"
  }
}
